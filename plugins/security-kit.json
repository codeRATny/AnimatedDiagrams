{
  "format": "animated-diagrams-plugin",
  "formatVersion": 1,
  "id": "animated-diagrams.security-kit",
  "name": "Security kit",
  "version": "1.0.0",
  "author": "Animated Diagrams",
  "description": "Demo plugin: IdP, WAF, secrets vault, tokens; “denied” and “verified” effects; OAuth 2.0, JWT validation and attack blocking scenarios; the “Terminal” design system.",
  "elements": [
    {
      "id": "idp",
      "label": "Identity provider",
      "icon": "ID",
      "category": "Security",
      "description": "Keycloak / Auth0 / OIDC provider",
      "accent": "$secondary",
      "width": 160.0,
      "height": 66.0,
      "style": {
        "shape": "rounded",
        "fill": "$surface",
        "stroke": "$secondary"
      }
    },
    {
      "id": "policy",
      "label": "Policy engine",
      "icon": "PDP",
      "category": "Security",
      "description": "OPA / access decisions",
      "accent": "$info",
      "width": 150.0,
      "height": 62.0,
      "style": {
        "shape": "rect",
        "fill": "$surface",
        "stroke": "$info"
      }
    },
    {
      "id": "vault",
      "label": "Secrets vault",
      "icon": "V",
      "category": "Security",
      "description": "HashiCorp Vault / KMS",
      "accent": "#ffd814",
      "width": 160.0,
      "height": 66.0,
      "style": {
        "shape": "hexagon",
        "fill": "$surface",
        "stroke": "#ffd814"
      }
    },
    {
      "id": "waf",
      "label": "WAF",
      "icon": "W",
      "category": "Security",
      "description": "Web application firewall (custom SVG shield outline)",
      "accent": "$danger",
      "width": 120.0,
      "height": 90.0,
      "style": {
        "shape": "custom",
        "customPath": "M0.5 0 L1 0.15 L0.92 0.7 L0.5 1 L0.08 0.7 L0 0.15 Z",
        "fill": "$surface",
        "stroke": "$danger"
      }
    },
    {
      "id": "token",
      "label": "Token",
      "icon": "T",
      "category": "Security",
      "description": "JWT / access token",
      "accent": "$warning",
      "width": 120.0,
      "height": 52.0,
      "style": {
        "shape": "ellipse",
        "fill": "$surface-alt",
        "stroke": "$warning"
      }
    },
    {
      "id": "ca",
      "label": "Certificate authority",
      "icon": "CA",
      "category": "Security",
      "description": "PKI, certificate issuing",
      "accent": "$success",
      "width": 150.0,
      "height": 72.0,
      "style": {
        "shape": "document",
        "fill": "$surface",
        "stroke": "$success"
      }
    },
    {
      "id": "attacker",
      "label": "Attacker",
      "icon": "!",
      "category": "Security",
      "description": "Attack source",
      "accent": "$danger",
      "width": 140.0,
      "height": 70.0,
      "style": {
        "shape": "ellipse",
        "fill": "$surface-alt",
        "stroke": "$danger",
        "strokeStyle": "dashed"
      }
    }
  ],
  "effects": [
    {
      "id": "denied",
      "label": "Denied",
      "category": "Security",
      "description": "A red flash and a shake — access denied",
      "color": "$danger",
      "repeat": 1,
      "tracks": [
        {
          "property": "tint",
          "keys": [
            {
              "t": 0.0,
              "value": 0.0
            },
            {
              "t": 0.15,
              "value": 0.7,
              "easing": "ease-out"
            },
            {
              "t": 1.0,
              "value": 0.0,
              "easing": "ease-in"
            }
          ]
        },
        {
          "property": "offset_x",
          "keys": [
            {
              "t": 0.0,
              "value": 0.0
            },
            {
              "t": 0.1,
              "value": -8.0
            },
            {
              "t": 0.2,
              "value": 8.0
            },
            {
              "t": 0.3,
              "value": -6.0
            },
            {
              "t": 0.4,
              "value": 6.0
            },
            {
              "t": 0.5,
              "value": -3.0
            },
            {
              "t": 0.6,
              "value": 0.0
            },
            {
              "t": 1.0,
              "value": 0.0
            }
          ]
        }
      ]
    },
    {
      "id": "verified",
      "label": "Verified",
      "category": "Security",
      "description": "A green glow with a bounce — the check passed",
      "color": "$success",
      "repeat": 1,
      "tracks": [
        {
          "property": "scale",
          "keys": [
            {
              "t": 0.0,
              "value": 1.0
            },
            {
              "t": 0.25,
              "value": 1.1,
              "easing": "back-out"
            },
            {
              "t": 0.6,
              "value": 1.0,
              "easing": "ease-in-out"
            },
            {
              "t": 1.0,
              "value": 1.0
            }
          ]
        },
        {
          "property": "glow",
          "keys": [
            {
              "t": 0.0,
              "value": 0.0
            },
            {
              "t": 0.25,
              "value": 1.0,
              "easing": "ease-out"
            },
            {
              "t": 1.0,
              "value": 0.0,
              "easing": "ease-in"
            }
          ]
        }
      ]
    },
    {
      "id": "locked",
      "label": "Block",
      "category": "Security",
      "description": "The node “shrinks” and dims — blocked",
      "color": "$warning",
      "repeat": 1,
      "tracks": [
        {
          "property": "scale",
          "keys": [
            {
              "t": 0.0,
              "value": 1.0
            },
            {
              "t": 0.3,
              "value": 0.88,
              "easing": "ease-in"
            },
            {
              "t": 1.0,
              "value": 0.92,
              "easing": "ease-out"
            }
          ]
        },
        {
          "property": "opacity",
          "keys": [
            {
              "t": 0.0,
              "value": 1.0
            },
            {
              "t": 1.0,
              "value": 0.55,
              "easing": "ease-out"
            }
          ]
        }
      ]
    },
    {
      "id": "scan",
      "label": "Scanning",
      "category": "Security",
      "description": "A rhythmic highlight — traffic is being inspected",
      "color": "$info",
      "repeat": 3,
      "tracks": [
        {
          "property": "glow",
          "keys": [
            {
              "t": 0.0,
              "value": 0.1
            },
            {
              "t": 0.5,
              "value": 0.9,
              "easing": "ease-in-out"
            },
            {
              "t": 1.0,
              "value": 0.1,
              "easing": "ease-in-out"
            }
          ]
        }
      ]
    }
  ],
  "animations": [
    {
      "id": "oauth-code-flow",
      "label": "OAuth 2.0: authorization code",
      "category": "Security",
      "description": "User sign-in through the IdP, code-for-token exchange and an API call",
      "roles": [
        {
          "id": "user",
          "label": "User"
        },
        {
          "id": "client",
          "label": "Application"
        },
        {
          "id": "idp",
          "label": "IdP"
        },
        {
          "id": "api",
          "label": "API"
        }
      ],
      "steps": [
        {
          "id": "t1",
          "type": "message",
          "start": 0.0,
          "duration": 700.0,
          "from": "user",
          "to": "client",
          "variant": "request",
          "label": "sign in"
        },
        {
          "id": "t2",
          "type": "message",
          "start": 700.0,
          "duration": 700.0,
          "from": "client",
          "to": "user",
          "variant": "response",
          "label": "redirect"
        },
        {
          "id": "t3",
          "type": "message",
          "start": 1400.0,
          "duration": 900.0,
          "from": "user",
          "to": "idp",
          "variant": "request",
          "label": "login + password"
        },
        {
          "id": "t4",
          "type": "effect",
          "start": 2300.0,
          "duration": 700.0,
          "nodeId": "idp",
          "effect": "verified"
        },
        {
          "id": "t5",
          "type": "message",
          "start": 3000.0,
          "duration": 800.0,
          "from": "idp",
          "to": "client",
          "variant": "response",
          "label": "code"
        },
        {
          "id": "t6",
          "type": "message",
          "start": 3800.0,
          "duration": 800.0,
          "from": "client",
          "to": "idp",
          "variant": "request",
          "label": "code + secret"
        },
        {
          "id": "t7",
          "type": "message",
          "start": 4600.0,
          "duration": 900.0,
          "from": "idp",
          "to": "client",
          "variant": "success",
          "label": "access token",
          "packet": "envelope"
        },
        {
          "id": "t8",
          "type": "message",
          "start": 5500.0,
          "duration": 800.0,
          "from": "client",
          "to": "api",
          "variant": "request",
          "label": "Bearer …"
        },
        {
          "id": "t9",
          "type": "action",
          "start": 6300.0,
          "duration": 700.0,
          "nodeId": "api",
          "text": "token check"
        },
        {
          "id": "t10",
          "type": "message",
          "start": 7000.0,
          "duration": 800.0,
          "from": "api",
          "to": "client",
          "variant": "success",
          "label": "200 OK"
        }
      ]
    },
    {
      "id": "jwt-validation",
      "label": "JWT validation at the gateway",
      "category": "Security",
      "description": "The gateway checks the token signature with the IdP keys; an expired token is rejected",
      "roles": [
        {
          "id": "client",
          "label": "Client"
        },
        {
          "id": "gateway",
          "label": "Gateway"
        },
        {
          "id": "idp",
          "label": "IdP (JWKS)"
        },
        {
          "id": "service",
          "label": "Service"
        }
      ],
      "steps": [
        {
          "id": "t1",
          "type": "message",
          "start": 0.0,
          "duration": 800.0,
          "from": "client",
          "to": "gateway",
          "variant": "request",
          "label": "JWT"
        },
        {
          "id": "t2",
          "type": "message",
          "start": 800.0,
          "duration": 700.0,
          "from": "gateway",
          "to": "idp",
          "variant": "request",
          "label": "JWKS"
        },
        {
          "id": "t3",
          "type": "message",
          "start": 1500.0,
          "duration": 700.0,
          "from": "idp",
          "to": "gateway",
          "variant": "response",
          "label": "keys"
        },
        {
          "id": "t4",
          "type": "effect",
          "start": 2200.0,
          "duration": 600.0,
          "nodeId": "gateway",
          "effect": "verified"
        },
        {
          "id": "t5",
          "type": "message",
          "start": 2800.0,
          "duration": 800.0,
          "from": "gateway",
          "to": "service",
          "variant": "request",
          "label": "user=42"
        },
        {
          "id": "t6",
          "type": "message",
          "start": 3600.0,
          "duration": 900.0,
          "from": "service",
          "to": "client",
          "variant": "success",
          "label": "200"
        },
        {
          "id": "t7",
          "type": "message",
          "start": 4700.0,
          "duration": 800.0,
          "from": "client",
          "to": "gateway",
          "variant": "request",
          "label": "JWT (exp)"
        },
        {
          "id": "t8",
          "type": "effect",
          "start": 5500.0,
          "duration": 700.0,
          "nodeId": "gateway",
          "effect": "denied"
        },
        {
          "id": "t9",
          "type": "message",
          "start": 5700.0,
          "duration": 800.0,
          "from": "gateway",
          "to": "client",
          "variant": "error",
          "label": "401"
        }
      ]
    },
    {
      "id": "block-attack",
      "label": "WAF blocks an attack",
      "category": "Security",
      "description": "A flood from one address hits the WAF and is blocked; legitimate requests pass",
      "roles": [
        {
          "id": "attacker",
          "label": "Attacker"
        },
        {
          "id": "user",
          "label": "User"
        },
        {
          "id": "waf",
          "label": "WAF"
        },
        {
          "id": "api",
          "label": "API"
        }
      ],
      "steps": [
        {
          "id": "t1",
          "type": "message",
          "start": 0.0,
          "duration": 700.0,
          "from": "user",
          "to": "waf",
          "variant": "request",
          "label": "GET"
        },
        {
          "id": "t2",
          "type": "message",
          "start": 700.0,
          "duration": 700.0,
          "from": "waf",
          "to": "api",
          "variant": "request",
          "label": "GET"
        },
        {
          "id": "t3",
          "type": "message",
          "start": 600.0,
          "duration": 1600.0,
          "from": "attacker",
          "to": "waf",
          "variant": "error",
          "label": "flood",
          "packet": "dot",
          "packetCount": 8
        },
        {
          "id": "t4",
          "type": "effect",
          "start": 1000.0,
          "duration": 1800.0,
          "nodeId": "waf",
          "effect": "scan"
        },
        {
          "id": "t5",
          "type": "message",
          "start": 2400.0,
          "duration": 800.0,
          "from": "waf",
          "to": "attacker",
          "variant": "error",
          "label": "429"
        },
        {
          "id": "t6",
          "type": "effect",
          "start": 3200.0,
          "duration": 900.0,
          "nodeId": "attacker",
          "effect": "locked"
        },
        {
          "id": "t7",
          "type": "state",
          "start": 3200.0,
          "duration": 2600.0,
          "nodeId": "attacker",
          "state": "disabled",
          "label": "blocked"
        },
        {
          "id": "t8",
          "type": "message",
          "start": 1500.0,
          "duration": 800.0,
          "from": "api",
          "to": "user",
          "variant": "success",
          "label": "200"
        }
      ]
    }
  ],
  "designSystems": [
    {
      "id": "terminal",
      "label": "Terminal",
      "category": "Security",
      "description": "Green on black, monospaced font, straight edges",
      "background": "#070b08",
      "edgeColor": "#2f8f4e",
      "textColor": "#c4f5cf",
      "grid": false,
      "fontFamily": "DejaVu Sans Mono",
      "subtitleColor": "#7fcf95",
      "colors": {
        "accent": "#39ff88",
        "border": "#2f8f4e",
        "danger": "#ff4d6d",
        "info": "#7ee8fa",
        "muted": "#7fcf95",
        "primary": "#39ff88",
        "secondary": "#7ee8fa",
        "success": "#39ff88",
        "surface": "#0d1a10",
        "surface-alt": "#08120b",
        "text": "#c4f5cf",
        "warning": "#f2ff5c"
      },
      "states": {
        "active": {
          "fill": "#0f2e1a",
          "ring": "#39ff88"
        },
        "busy": {
          "fill": "#2a2d0d",
          "ring": "#f2ff5c"
        },
        "disabled": {
          "fill": "#0a0f0b",
          "ring": "#3d5243"
        },
        "down": {
          "fill": "#2d0d14",
          "ring": "#ff4d6d"
        },
        "ok": {
          "fill": "#0d1a10",
          "ring": "#2f8f4e"
        },
        "success": {
          "fill": "#0f2e1a",
          "ring": "#39ff88"
        },
        "warn": {
          "fill": "#2d200d",
          "ring": "#ffb84d"
        }
      },
      "variants": {
        "error": "#ff4d6d",
        "event": "#c792ea",
        "request": "#7ee8fa",
        "response": "#39ff88",
        "retry": "#f2ff5c",
        "success": "#39ff88"
      },
      "node": {
        "strokeWidth": 1.5,
        "cornerRadius": 0.0,
        "shadow": false
      },
      "edge": {
        "arrowEnd": "open",
        "routing": "straight",
        "labelColor": "#7fcf95"
      }
    }
  ],
  "translations": {
    "ru": {
      "A flood from one address hits the WAF and is blocked; legitimate requests pass": "Флуд с одного адреса упирается в WAF и блокируется; легитимные запросы проходят",
      "A green glow with a bounce — the check passed": "Зелёное свечение с отскоком — проверка пройдена",
      "A red flash and a shake — access denied": "Красная вспышка и встряхивание — доступ запрещён",
      "A rhythmic highlight — traffic is being inspected": "Ритмичная подсветка — идёт анализ трафика",
      "Application": "Приложение",
      "Attack source": "Источник атаки",
      "Attacker": "Злоумышленник",
      "Block": "Блокировка",
      "Certificate authority": "Удостоверяющий центр",
      "Client": "Клиент",
      "Demo plugin: IdP, WAF, secrets vault, tokens; “denied” and “verified” effects; OAuth 2.0, JWT validation and attack blocking scenarios; the “Terminal” design system.": "Демо-плагин: IdP, WAF, хранилище секретов, токены; эффекты «отказ» и «проверено»; сценарии OAuth 2.0, проверки JWT и блокировки атаки; дизайн-система «Терминал».",
      "Denied": "Отказ",
      "Gateway": "Шлюз",
