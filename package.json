{
  "name": "animated-diagrams",
  "productName": "Animated Diagrams",
  "version": "1.0.0",
  "description": "Редактор анимированных диаграмм: flow-сценарии с сообщениями, таймерами, состояниями; экспорт в GIF/WebM",
  "author": {
    "name": "Animated Diagrams",
    "email": "noreply@animateddiagrams.app"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:nosandbox": "electron . --no-sandbox",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "pack:linux": "electron-builder --linux AppImage deb",
    "pack:win": "electron-builder --win nsis",
    "pack:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.animateddiagrams.app",
    "productName": "Animated Diagrams",
    "files": [
      "electron/**/*",
      "index.html",
      "css/**/*",
      "js/**/*",
      "!**/*.map"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "deb": {
      "maintainer": "Animated Diagrams <noreply@animateddiagrams.app>"
    },
    "rpm": {},
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
